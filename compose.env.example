# Copy to .env.compose; pass with docker compose --env-file .env.compose.
# Select a host UID/GID with read access to movie and write access to runtime.
# POSIX example: id -u; id -g. The image default is 10001:10001.
MOVIESITES_UID=10001
MOVIESITES_GID=10001
MOVIESITES_IMAGE=moviesites:ubuntu26.04
MOVIESITES_BIND_ADDRESS=127.0.0.1
MOVIESITES_WEB_PORT=8080
MOVIESITES_MEDIA_PATH=./movie
MOVIESITES_DATA_PATH=./runtime
MOVIESITES_ENV_FILE=.env.example
JAVA_BUILD_IMAGE=moviesites-java-build:25-ubuntu26.04
JAVA_RUNTIME_IMAGE=moviesites-java-runtime:25-ubuntu26.04
