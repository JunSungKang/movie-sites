# Docker example: pass with --env-file .env.example.
# The JAR does not automatically read .env files; export host paths separately.
MOVIESITES_MEDIA_ROOT=/media
MOVIESITES_DATA_ROOT=/data
MOVIESITES_THEME=20s-midnight-stream
# Optional conservative filename suggestions: none or kids-education.
MOVIESITES_TOPIC_PROFILE=none
# Interface language: en or ko. This does not change native UTF-8 filename handling.
MOVIESITES_UI_LOCALE=en
# Optional HTTP(S) origin, without a path; blank disables canonical/sitemap URLs.
MOVIESITES_PUBLIC_URL=
MOVIESITES_BROWSER_CACHE_TTL_SECONDS=120
MOVIESITES_FOLDER_LABELS={}
PORT=8080
