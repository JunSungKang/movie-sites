# Optional Movie Kids operating preset. No host-specific paths or credentials.
# Docker: --env-file movie-kids.env.example
# Compose: MOVIESITES_ENV_FILE=movie-kids.env.example docker compose up -d
# For an existing deployment, preserve its service identity and external mounts.
MOVIESITES_MEDIA_ROOT=/media
MOVIESITES_DATA_ROOT=/data
MOVIESITES_THEME=child-toy
MOVIESITES_UI_LOCALE=ko
MOVIESITES_TOPIC_PROFILE=kids-education
MOVIESITES_PUBLIC_URL=
MOVIESITES_FOLDER_LABELS={}
MOVIESITES_BROWSER_CACHE_TTL_SECONDS=120
PORT=8080
