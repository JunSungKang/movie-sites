{
  "schema_version": 1,
  "id": "moviesites",
  "version": "v4",
  "goal": "Implement and publicly run a self-hosted, folder-based video journal with external media storage",
  "excluded": [
    "Kubernetes",
    "Helm",
    "database",
    "global index",
    "continuous filesystem watches",
    "separate frontend runtime",
    "upload/delete APIs",
    "authentication"
  ],
  "assumptions": [
    "Public access is anonymous read-only",
    "Current host and Docker must remain running for availability"
  ],
  "open_questions": [],
  "approval": {
    "status": "approved",
    "spec_version": "v4",
    "evidence": "2026-11-07 user: 개발 시작해. 서비스로 외부에서 접속되도록까지 오픈까지 완료해. 중간에 멈추지마; subsequent approval of initial GitHub flow repair and immediate continuation. Scope follows the v4 design with Dockerfile-only deployment.",
    "spec_sha256": "2fc52eb2dcb17c8d6733fc05d995f2a09d1e30104dfe788795d9d8d4e80299fd"
  },
  "requirements": [
    {
      "id": "R01",
      "priority": "must",
      "statement": "Single JDK25 Spring Boot application",
      "acceptance": "Maven verify and JAR start succeed",
      "checks": [
        "C01"
      ]
    },
    {
      "id": "R02",
      "priority": "must",
      "statement": "External media and work roots",
      "acceptance": "Roots are configurable, disjoint, and original media is not packaged",
      "checks": [
        "C02"
      ]
    },
    {
      "id": "R03",
      "priority": "must",
      "statement": "Immediate-directory browsing",
      "acceptance": "No recursive enumeration; bounded cursors reject stale/wrong-path use",
      "checks": [
        "C03"
      ]
    },
    {
      "id": "R04",
      "priority": "must",
      "statement": "Path-scoped browser cache",
      "acceptance": "TTL 60-180s, fixed fetch expiry and bounded LRU",
      "checks": [
        "C04"
      ]
    },
    {
      "id": "R05",
      "priority": "must",
      "statement": "Horizontal journal UI",
      "acceptance": "Desktop horizontal rows, mobile reflow, no layout toggle",
      "checks": [
        "C05"
      ]
    },
    {
      "id": "R06",
      "priority": "must",
      "statement": "Standard browser playback",
      "acceptance": "Native HTML video, HTTP ranges and bounded compatibility processing",
      "checks": [
        "C06"
      ]
    },
    {
      "id": "R07",
      "priority": "must",
      "statement": "NAS and resource handling",
      "acceptance": "Storage failures distinct from empty results and bounded jobs/streams",
      "checks": [
        "C07"
      ]
    },
    {
      "id": "R08",
      "priority": "must",
      "statement": "Dockerfile deployment",
      "acceptance": "Build and run a single container with external read-only media mount",
      "checks": [
        "C08"
      ]
    },
    {
      "id": "R09",
      "priority": "must",
      "statement": "Package/data separation",
      "acceptance": "Git, JAR and image exclude originals and generated runtime data",
      "checks": [
        "C09"
      ]
    },
    {
      "id": "R10",
      "priority": "must",
      "statement": "Open-source delivery",
      "acceptance": "AGPL license, source link and dependency notices included",
      "checks": [
        "C10"
      ]
    },
    {
      "id": "R11",
      "priority": "must",
      "statement": "Externally reachable service",
      "acceptance": "External HTTP observation and functional navigation/playback checks",
      "checks": [
        "C11"
      ]
    }
  ],
