  "goal": "General-purpose video platform documentation and 19 startup-selectable, independently styled themes",
  "excluded": [
    "Media modifications",
    "Database, recursive indexing or watchers",
    "Separate frontend server",
    "Kubernetes or Helm",
    "Authentication redesign"
  ],
  "assumptions": [
    "Age groups organize optional presets; no age is collected and every preset is available to every user.",
    "Existing deployment remains child-toy unless explicitly configured."
  ],
