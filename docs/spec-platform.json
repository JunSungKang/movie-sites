    },
    {
      "id": "R02",
      "priority": "must",
      "statement": "Select one of 19 themes at process startup",
      "acceptance": "MOVIESITES_THEME defaults to child-toy, selects each valid ID, and rejects unknown or unsafe values; six age groups contain three presets each.",
      "checks": [
        "C01",
        "C02"
      ]
    },
    {
      "id": "R03",
      "priority": "must",
      "statement": "Maintain themes in a dedicated directory with distinct designs",
      "acceptance": "Each theme has its own manifest/style/decorative asset under static/themes; layouts, geometry, density and type differ across presets; catalog previews real pages on mobile.",
      "checks": [
        "C01",
        "C02"
      ]
    },
    {
      "id": "R04",
      "priority": "must",
      "statement": "Preserve the running platform and external media",
      "acceptance": "Builds, resource limits, bounded cache, nested navigation, covers and native playback remain functional; videos stay outside Git/JAR/image and original media identities remain unchanged.",
      "checks": [
        "C01",
        "C02"
      ]
    }
  ],
